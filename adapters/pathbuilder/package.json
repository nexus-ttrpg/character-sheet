{
  "name": "@nexus-ttrpg/pathbuilder-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Pathbuilder 2e adapter — the first third-party-builder (import-only) adapter (§8, §19 Phase 3 stretch). Demonstrates non-lossy ability-score component round-trip (§3.3), unlike the lossy Roll20 path.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/bundle.ts --bundle --format=esm --target=es2022 --outfile=dist/bundle/bundle.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexus-ttrpg/adapter-sdk": "workspace:*",
    "@nexus-ttrpg/schema-types": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.27.0"
  }
}

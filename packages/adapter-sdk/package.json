{
  "name": "@nexus-sheet/adapter-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "The contribution surface: CharacterAdapter interface, contexts, warnings/errors, and the contract test harness (§5). A contributor writing an adapter never installs Rust.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nexus-sheet/schema-types": "workspace:*"
  },
  "devDependencies": {
    "@nexus-sheet/schema-zod": "workspace:*"
  }
}

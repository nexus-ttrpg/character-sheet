{
  "name": "@nexus-sheet/web",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal web UI — snapshot DAG timeline, conflict resolution, client-side WASM diff preview (Phase 3.1).",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/sync-engine-wasm --target web --release --out-dir ../../packages/web/src/wasm",
    "build": "node build.mjs",
    "dev": "node build.mjs --watch --serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
